{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-debug",
      "displayName": "macOS · Qt 6.8.3 · Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Qt6_DIR": "/Volumes/Storage/Qt/6.8.3/macos/lib/cmake/Qt6",
        "LVRS_DIR": "$env{HOME}/.local/SDK/LVRS",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    }
  ],
  "testPresets": [
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
