            Label(id: "migratedText17", text: "Background", style: .body)
            Label(id: "migratedText18", text: "Select a preset or customize its dimensions before creating.", style: .body)
            Label(id: "migratedText19", text: "Pixels (px)", style: .body)
            Label(id: "migratedText20", text: "Millimeters (mm)", style: .body)
            Label(id: "migratedText21", text: "Inches (in)", style: .body)
            Label(id: "migratedText22", text: "White", style: .body)
