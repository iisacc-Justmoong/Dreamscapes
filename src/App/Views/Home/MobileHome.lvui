import vm NativeMigratedViewBackend
EventListener(id: "migratedSurface", width: 0, height: 0, flex: 1, onSizeChanged: vm.sizeChanged) {
    ScrollView(id: "migratedScroll", width: vm.viewportWidth, height: vm.viewportHeight) {
        VStack(id: "migratedContent", width: vm.viewportWidth, spacing: Metric.space8,
               leftPadding: Metric.space16, rightPadding: Metric.space16,
               topPadding: Metric.space16, bottomPadding: Metric.space16, alignment: .stretch) {
            Label(id: "migratedHeading", text: "Mobile Home", style: .header2)
            Label(id: "migratedText0", text: "빠른 시작", style: .body)
            Label(id: "migratedText1", text: "새 캔버스", style: .body)
            Label(id: "migratedText2", text: "이미지 생성", style: .body)
            Label(id: "migratedText3", text: "비디오 생성", style: .body)
            Label(id: "migratedText4", text: "보드 생성", style: .body)
            Label(id: "migratedText5", text: "Open file", style: .body)
            Label(id: "migratedText6", text: "Recent files", style: .body)
            Label(id: "migratedText7", text: "Recent published", style: .body)
            Label(id: "migratedText8", text: "View all", style: .body)
            Label(id: "migratedText9", text: "Generation history", style: .body)
        }
    }
}
