import vm NativeMigratedViewBackend
EventListener(id: "migratedSurface", width: 0, height: 0, flex: 1, onSizeChanged: vm.sizeChanged) {
    ScrollView(id: "migratedScroll", width: vm.viewportWidth, height: vm.viewportHeight) {
        VStack(id: "migratedContent", width: vm.viewportWidth, spacing: Metric.space8,
               leftPadding: Metric.space16, rightPadding: Metric.space16,
               topPadding: Metric.space16, bottomPadding: Metric.space16, alignment: .stretch) {
            Label(id: "migratedHeading", text: "Desktop Home Sidebar", style: .header2)
            Label(id: "migratedText0", text: "Home", style: .body)
            Label(id: "migratedText1", text: "New Canvas", style: .body)
            Label(id: "migratedText2", text: "Image", style: .body)
            Label(id: "migratedText3", text: "Video", style: .body)
            Label(id: "migratedText4", text: "Audio", style: .body)
            Label(id: "migratedText5", text: "Board", style: .body)
            Label(id: "migratedText6", text: "Tools", style: .body)
            Label(id: "migratedText7", text: "Files", style: .body)
            Label(id: "migratedText8", text: "Assets", style: .body)
            Label(id: "migratedText9", text: "Generation History", style: .body)
        }
    }
}
