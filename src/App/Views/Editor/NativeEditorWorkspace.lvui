import vm NativeEditorWorkspaceBackend
@Static let resizeEditor: (Double, Double) -> Void = vm.sizeHandler(Metric.size280, Metric.size22, Metric.space8)
@Static let resizeEditorCanvas: (Double, Double) -> Void = vm.canvasSizeHandler(Metric.space8)
EventListener(id: "editorSurface", width: 0, height: 0, flex: 1, onSizeChanged: resizeEditor) {
    VStack(id: "editorWorkspace", width: vm.width, height: vm.height, spacing: Metric.space4, alignment: .stretch) {
        HStack(spacing: Metric.space8, padding: Metric.space8, alignment: .center) {
            if (vm.hasDocument) {
                Label(id: "editorDocumentName", text: vm.title, style: .body, flex: 1)
            } else {
                Label(id: "editorNoDocument", text: "No canvas open", style: .body, flex: 1)
            }
            if (vm.dirty) { Label(id: "editorUnsaved", text: "Unsaved", style: .caption) }
            LabelButton(id: "editorOpenFile", text: "Open", tone: .default, enabled: vm.canOpenFile, onClick: vm.openFile)
            LabelButton(id: "editorSaveFile", text: "Save", tone: .default, enabled: vm.canSaveFile, onClick: vm.saveFile)
            LabelButton(id: "editorSaveFileAs", text: "Save as", tone: .default, enabled: vm.canSaveFileAs, onClick: vm.saveFileAs)
            LabelButton(id: "editorPublish", text: "Publish", tone: .default, enabled: vm.hasDocument, onClick: vm.publish)
        }
        if (vm.fileMessage != "") {
            Label(id: "editorFileMessage", text: vm.fileMessage, style: .caption)
        }
        HStack(id: "editorBody", height: 0, flex: 1, spacing: Metric.space4, alignment: .stretch) {
            VStack(id: "editorCanvasArea", width: vm.canvasWidth, spacing: Metric.space8,
                   padding: Metric.space8, alignment: .stretch) {
                if (vm.hasDocument) {
                    Label(id: "editorDimensions", text: vm.dimensions, style: .caption)
                }
                EventListener(id: "editorCanvasSurface", width: 0, height: 0, flex: 1,
                              onSizeChanged: resizeEditorCanvas) {
                    ZStack(width: vm.previewWidth, height: vm.previewHeight, alignment: .center) {
                        if (vm.hasDocument) {
                            ZStack(width: vm.previewWidth, height: vm.previewHeight, alignment: .center) {
                                if (vm.hasFrame) {
                                    ZStack(width: vm.previewWidth, height: vm.previewHeight, alignment: .center) {
                                        Image(id: "editorCanvasFrame", source: vm.renderedFrame,
                                              width: vm.previewWidth, height: vm.previewHeight, fit: .Contain)
                                        if (vm.elementsPanelActive) {
                                            if (vm.selectingTool) {
                                                NativeView(id: "editorSelectionOverlay", source: vm.selectionView,
                                                           width: vm.previewWidth, height: vm.previewHeight)
                                            } else {
                                                NativeView(id: "editorShapeOverlay", source: vm.shapeView,
                                                           width: vm.previewWidth, height: vm.previewHeight)
                                            }
                                        }
                                        if (vm.textPanelActive) {
                                            NativeView(id: "editorTextOverlay", source: vm.textView,
                                                       width: vm.previewWidth, height: vm.previewHeight)
                                        }
                                        if (vm.maskPanelActive && vm.maskLassoActive) {
                                            NativeView(id: "editorMaskLassoOverlay", source: vm.maskLassoView,
                                                       width: vm.previewWidth, height: vm.previewHeight)
                                        }
                                        if (vm.brushPanelActive) {
                                            NativeView(id: "editorBrushOverlay", source: vm.brushView,
                                                       width: vm.previewWidth, height: vm.previewHeight)
                                        }
                                    }
                                }
                                if (vm.renderStatus != "") {
                                    Label(id: "editorCanvasStatus", text: vm.renderStatus, style: .caption)
                                }
                            }
                        } else {
                            Label(text: "Open a canvas to begin", style: .caption)
                        }
                    }
                }
                if (vm.elementsPanelActive && vm.selectingTool && vm.selectionStatus != "") {
                    Label(id: "editorSelectionStatus", text: vm.selectionStatus, style: .caption)
                }
            }
            VStack(id: "editorLayersSlot", width: vm.panelWidth, spacing: 0, alignment: .stretch) {
                NativeView(id: "editorPanelView", source: vm.panelView, width: vm.panelWidth, height: 0, flex: 1)
            }
            VStack(id: "editorToolBar", width: Metric.size22, spacing: Metric.space2, alignment: .center) {
                IconButton(id: "editorBrushTool", iconName: "brush", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, enabled: vm.brushAvailable, checkable: false, checked: vm.brushPanelActive,
                           selectionStyle: .segmented, accessibilityName: "Brush", onClick: vm.showBrushPanel)
                IconButton(id: "editorElementsTool", iconName: "rectangle", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, checkable: false, checked: vm.elementsPanelActive && !vm.selectingTool, selectionStyle: .segmented,
                           accessibilityName: "Elements", onClick: vm.showElementsPanel)
                IconButton(id: "editorTextTool", iconName: "text", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, checkable: false, checked: vm.textPanelActive, selectionStyle: .segmented,
                           accessibilityName: "Text", onClick: vm.showTextPanel)
                IconButton(id: "editorBackgroundTool", iconName: "panel-background-mask", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, checkable: false, checked: vm.backgroundPanelActive, selectionStyle: .segmented,
                           accessibilityName: "Background", onClick: vm.showMaskPanel)
                IconButton(id: "editorAudioTool", iconName: "audio-track", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, enabled: vm.audioAvailable, checkable: false, checked: vm.audioPanelActive,
                           selectionStyle: .segmented, accessibilityName: "Audio track", onClick: vm.showAudioPanel)
                IconButton(id: "editorLightTool", iconName: "adjustment", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, enabled: vm.lightAvailable, checkable: false, checked: vm.lightPanelActive,
                           selectionStyle: .segmented, accessibilityName: "Light adjustment", onClick: vm.showLightPanel)
                IconButton(id: "editorFileTool", iconName: "document-properties", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, checkable: false, checked: vm.filePanelActive, selectionStyle: .segmented,
                           accessibilityName: "File", onClick: vm.showFilePanel)
                IconButton(id: "editorCanvasTool", iconName: "canvas-size", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, checkable: false, checked: vm.canvasPanelActive, selectionStyle: .segmented,
                           accessibilityName: "Canvas", onClick: vm.showCanvasPanel)
                IconButton(id: "editorLayerTool", iconName: "panel-layers-stack", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, checkable: false, checked: vm.layerPanelActive, selectionStyle: .segmented,
                           accessibilityName: "Layers", onClick: vm.showLayerPanel)
                IconButton(id: "editorSelectTool", iconName: "direct-select", width: Metric.size22, height: Metric.size22,
                           tone: .borderless, checkable: false, checked: vm.selectingTool && vm.elementsPanelActive, selectionStyle: .segmented,
                           accessibilityName: "Select", onClick: vm.showSelectTool)
            }
        }
        HStack(id: "editorTimeline", spacing: Metric.space8, padding: Metric.space8, alignment: .center) {
            Label(text: "Timeline", style: .body)
            LabelButton(id: "editorPreviousFrame", text: "Previous", tone: .default, enabled: vm.canPrevious, onClick: vm.previous)
            LabelButton(id: "editorPlay", text: vm.playText, tone: .default, enabled: vm.canPlay, onClick: vm.togglePlayback)
            Label(id: "editorFrame", text: vm.frameText, style: .caption)
            LabelButton(id: "editorNextFrame", text: "Next", tone: .default, enabled: vm.canNext, onClick: vm.next)
            if (vm.timelineStatus != "") { Label(id: "editorTimelineStatus", text: vm.timelineStatus, style: .caption) }
            Label(text: "", style: .caption, flex: 1)
            IconButton(id: "timelineNewLayer", iconName: "new-layer", width: Metric.size22, height: Metric.size22,
                       tone: .borderless, enabled: vm.hasDocument, accessibilityName: "New layer or audio track",
                       onClick: vm.openTimelineMenu)
        }
        EventListener(id: "editorTimelineSurface", width: vm.width, height: Metric.size280,
                      onSizeChanged: vm.timelineSizeChanged) {
            NativeView(id: "editorTimelineView", source: vm.timelineView,
                       width: vm.timelineWidth, height: vm.timelineHeight)
        }
        Menu(id: "timelineNewMenu", targetId: "timelineNewLayer", showIconSlot: false) {
            MenuItem(id: "timelineNewStaticBitmap", label: "Static bitmap", showIconSlot: false,
                     hasChildItems: false, onClick: vm.createStaticBitmap)
            MenuItem(id: "timelineNewStaticVector", label: "Static vector", showIconSlot: false,
                     hasChildItems: false, onClick: vm.createStaticVector)
            MenuItem(id: "timelineNewDynamicBitmap", label: "Dynamic bitmap", showIconSlot: false,
                     hasChildItems: false, onClick: vm.createDynamicBitmap)
            MenuItem(id: "timelineNewDynamicVector", label: "Dynamic vector", showIconSlot: false,
                     hasChildItems: false, onClick: vm.createDynamicVector)
            MenuItem(id: "timelineNewAudio", label: "Audio track", showIconSlot: false,
                     hasChildItems: false, onClick: vm.createAudioTrack)
        }
    }
}
