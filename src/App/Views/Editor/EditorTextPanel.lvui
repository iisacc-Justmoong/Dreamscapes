import vm NativeTextPanelBackend
@Static let resizeText: (Double, Double) -> Void = vm.sizeHandler(Metric.space16)
EventListener(id: "textPanelSurface", width: 0, height: 0, flex: 1, onSizeChanged: resizeText) {
    ScrollView(width: vm.panelWidth, height: vm.panelHeight) {
        VStack(width: vm.panelWidth, padding: Metric.space8, spacing: Metric.space8, alignment: .stretch) {
            Label(text: "Text", style: .body)
            if (vm.status != "") { Label(id: "textStatus", text: vm.status, style: .caption) }
            Label(text: "Content", style: .caption)
            TextEditor(id: "textContent", text: vm.content, placeholder: vm.placeholder, accessibilityName: "Text content",
                       width: vm.contentWidth, height: Metric.size44, minimumHeight: Metric.size22,
                       verticalPadding: Metric.space2, wrapEnabled: true, onEdited: vm.contentEdited)
            Label(text: "Typeface", style: .caption)
            InputField(id: "textTypeface", text: vm.familyDraft, width: vm.contentWidth,
                       onEdited: vm.familyEdited, onSubmit: vm.familySubmitted, accessibilityName: "Typeface")
            Label(text: "Font size", style: .caption)
            Slider(id: "textSize", from: vm.minimum, to: vm.maximum, stepSize: vm.step, value: vm.size,
                   width: vm.contentWidth, size: .mini, accessibilityName: "Font size", onMoved: vm.sizeMoved)
            Label(text: "Color", style: .caption)
            InputField(id: "textColor", text: vm.colorDraft, width: vm.contentWidth,
                       onEdited: vm.colorEdited, onSubmit: vm.colorSubmitted, accessibilityName: "Text color")
        }
    }
}
