import vm NativeMigratedViewBackend
EventListener(id: "migratedSurface", width: 0, height: 0, flex: 1, onSizeChanged: vm.sizeChanged) {
    ScrollView(id: "migratedScroll", width: vm.viewportWidth, height: vm.viewportHeight) {
        VStack(id: "migratedContent", width: vm.viewportWidth, spacing: Metric.space8,
               leftPadding: Metric.space16, rightPadding: Metric.space16,
               topPadding: Metric.space16, bottomPadding: Metric.space16, alignment: .stretch) {
            Label(id: "migratedHeading", text: "Editor Background Color Panel", style: .header2)
            Label(id: "migratedText0", text: "Color picker", style: .body)
            Label(id: "migratedText1", text: "Hex", style: .body)
            Label(id: "migratedText2", text: "Alpha", style: .body)
            Label(id: "migratedText3", text: "RGB", style: .body)
            Label(id: "migratedText4", text: "HSB", style: .body)
            Label(id: "migratedText5", text: "Lab", style: .body)
            Label(id: "migratedText6", text: "CMYK", style: .body)
            Label(id: "migratedText7", text: "Opacity", style: .body)
            Label(id: "migratedText8", text: "Extend fill to bleed", style: .body)
            Label(id: "migratedText9", text: "Swatches", style: .body)
            Label(id: "migratedText10", text: "Add swatch", style: .body)
            Label(id: "migratedText11", text: "Recent colors", style: .body)
            Label(id: "migratedText12", text: "Gradient editor", style: .body)
            Label(id: "migratedText13", text: "Add stop", style: .body)
            Label(id: "migratedText14", text: "Remove stop", style: .body)
            Label(id: "migratedText15", text: "Reverse", style: .body)
            Label(id: "migratedText16", text: "Gradient presets", style: .body)
            Label(id: "migratedText17", text: "Apply color", style: .body)
            Label(id: "migratedText18", text: "Save preset", style: .body)
            Label(id: "migratedText19", text: "Gradient stop", style: .body)
        }
    }
}
