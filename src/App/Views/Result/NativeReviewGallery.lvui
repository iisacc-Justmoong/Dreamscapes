import nav NativeReviewNavigationScope
import vm NativeReviewGalleryBackend
@Static let resizeCompare: (Double, Double) -> Void = vm.compareSizeHandler(Metric.space8, Metric.size22, Metric.size140)
ApplicationWindow(title: "Dreamscapes · Results", width: 1440, height: 900) {
    VStack(spacing: 8, padding: 12, alignment: .stretch, flex: 1) {
        ZStack(id: "reviewBody", alignment: .stretch, flex: 1) {
          VStack(id: "galleryLayer", spacing: Metric.space8, alignment: .stretch, visible: vm.galleryVisible, flex: 1) {
        HStack(spacing: 4) {
            Label(text: "RESULTS", style: .caption)
            LabelButton(id: "all", text: "All", tone: .default, onClick: vm.showAll)
            LabelButton(id: "shortlisted", text: "Shortlisted", tone: .default, onClick: vm.showShortlisted)
            LabelButton(id: "unreviewed", text: "Unreviewed", tone: .default, onClick: vm.showUnreviewed)
            LabelButton(id: "rejected", text: "Rejected", tone: .default, onClick: vm.showRejected)
            LabelButton(id: "images", text: "Images", tone: .default, onClick: vm.showImages)
            LabelButton(id: "videos", text: "Videos", tone: .default, onClick: vm.showVideos)
            Label(text: vm.resultSummary, style: .caption)
        }
        for (item in vm.items, key: item.token, id: "results", itemHeight: 172,
             itemWidth: 160, spacing: 8, overscan: 1, navigation: nav,
             selectionMode: .multiple, selectOnMove: false, selectOnClick: false,
             activateOnDoubleClick: true, onActivate: vm.openDetail) {
            VStack(id: "result", spacing: 4, alignment: .stretch) {
                Image(id: "thumbnail", source: item.token, width: 152, height: 132, fit: .Cover)
                Label(id: "title", text: item.title, style: .caption)
                Label(id: "review", text: item.reviewLabel, style: .caption)
                ContextMenu(id: "reviewContextMenu", targetId: "result", showIconSlot: false,
                            onOpened: item.openMenu, onItemTriggered: item.menuAction) {
                    ContextMenuItem(id: "reviewContextShortlist", label: item.shortlistLabel(), hasChildItems: false)
                    ContextMenuItem(id: "reviewContextReject", label: item.rejectLabel(), hasChildItems: false)
                    ContextMenuItem(id: "reviewContextReset", label: item.resetLabel(), hasChildItems: false)
                    ContextMenuItem(id: "reviewContextCompare", label: item.compareLabel(), enabled: item.canContextCompare(), hasChildItems: false)
                    ContextMenuItem(id: "reviewContextEdit", label: item.editLabel(), enabled: item.canContextEdit(), hasChildItems: false)
                    ContextMenuItem(id: "reviewContextSaveFile", label: item.saveFileLabel(), enabled: item.canContextSaveFile(), hasChildItems: false)
                    ContextMenuItem(id: "reviewContextSavePhotos", label: item.savePhotosLabel(), enabled: item.canContextSavePhotos(), hasChildItems: false)
                }
            }
        }
          }
          EventListener(id: "compareSurface", width: 0, height: 0, flex: 1,
                        visible: vm.comparing, onSizeChanged: resizeCompare) {
            VStack(width: vm.compareWidth, height: vm.compareHeight, spacing: Metric.space8, alignment: .stretch) {
                HStack(height: Metric.size22, spacing: Metric.space8, alignment: .center) {
                    LabelButton(id: "compareBack", text: "Back", tone: .default, onClick: vm.closeCompare)
                    Label(text: "Compare · Preview pixels", style: .caption, flex: 1)
                    LabelButton(id: "compareFit", text: "Fit", tone: .default, onClick: vm.fitCompare)
                    LabelButton(id: "compareActual", text: "100%", tone: .default, onClick: vm.actualCompare)
                    LabelButton(id: "compareOut", text: "−", tone: .default, onClick: vm.zoomOutCompare)
                    LabelButton(id: "compareIn", text: "+", tone: .default, onClick: vm.zoomInCompare)
                    LabelButton(id: "compareSync", text: vm.syncLabel, tone: .default, onClick: vm.toggleCompareSync)
                }
                for (item in vm.compareItems, key: item.key, id: "compareItems", itemWidth: vm.compareCellWidth,
                     itemHeight: vm.compareCellHeight, spacing: Metric.space8, overscan: 1) {
                    VStack(width: vm.compareCellWidth, height: vm.compareCellHeight, spacing: Metric.space8, alignment: .stretch) {
                        HStack(height: Metric.size22, alignment: .center) {
                            Label(text: item.title, style: .caption, elideRight: true)
                        }
                        ZStack(width: vm.compareCellWidth, height: vm.comparePaneHeight, alignment: .center) {
                            NativeView(source: item.surface, width: vm.compareCellWidth, height: vm.comparePaneHeight)
                            Label(text: item.status, visible: item.status != "", style: .caption)
                        }
                    }
                }
            }
          }
        }
        HStack(spacing: 4) {
            Label(text: vm.selectionSummary, style: .caption)
            LabelButton(id: "shortlist", text: "Shortlist", tone: .default, enabled: vm.canReview, onClick: vm.shortlist)
            LabelButton(id: "reject", text: "Reject", tone: .default, enabled: vm.canReview, onClick: vm.reject)
            LabelButton(id: "clear", text: "Clear selection", tone: .default, enabled: vm.hasSelection, onClick: vm.clearSelection)
            LabelButton(id: "compare", text: "Compare", tone: .default, enabled: vm.canCompare, onClick: vm.compare)
            LabelButton(id: "edit", text: "Edit selected", tone: .default, enabled: vm.canEdit, onClick: vm.edit)
            LabelButton(id: "export", text: "Export", tone: .default, enabled: vm.canExport, onClick: vm.exportResults)
        }
    }
}
